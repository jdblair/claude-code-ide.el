{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "./scripts/format-and-clean.sh --hook",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "./scripts/compile-and-test.sh --hook",
            "type": "command"
          }
        ]
      }
    ]
  }
}